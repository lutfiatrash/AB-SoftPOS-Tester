<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. TOKEN -->
        <TextView
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Token" />

        <EditText
            android:id="@+id/serverUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Token server URL"
            android:inputType="textUri"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/readKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Server read key"
            android:inputType="text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/fetchTokenBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fetch token from server" />

        <EditText
            android:id="@+id/token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="authorizationToken (fetched, or paste manually, or leave empty to test launch only)"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="2"
            android:textSize="13sp" />

        <!-- 2. ACTIVITY -->
        <TextView
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="2. SoftPOS activity" />

        <Button
            android:id="@+id/discoverBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Discover SoftPOS activities" />

        <Spinner
            android:id="@+id/activitySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <!-- 3. OPERATIONS -->
        <TextView
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="3. Operations" />

        <Button
            android:id="@+id/signInBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sign In (no money)" />

        <EditText
            android:id="@+id/amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:hint="Amount in ILS, e.g. 1.00"
            android:inputType="numberDecimal"
            android:textSize="28sp" />

        <Button
            android:id="@+id/payBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pay" />

        <TextView
            android:id="@+id/lastTx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="No payment yet"
            android:textSize="12sp" />

        <Button
            android:id="@+id/reverseBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reverse last payment" />

        <Button
            android:id="@+id/checkBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check last operation status" />

        <!-- ADVANCED -->
        <TextView
            style="@style/TextAppearance.AppCompat.Subhead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Advanced (goods block)" />

        <EditText
            android:id="@+id/taxRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="taxRate"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="accountingSubject"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:textSize="13sp" />

        <!-- LOG -->
        <TextView
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Log (newest first)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/copyLogBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Copy log" />

            <Button
                android:id="@+id/clearLogBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clear" />
        </LinearLayout>

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
